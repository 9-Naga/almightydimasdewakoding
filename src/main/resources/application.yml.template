server:
  port: 8081
spring:
  application:
    name: projectbinar
  datasource:
    url: jdbc:sqlserver://localhost:1433;databaseName=Loan_db;encrypt=true;trustServerCertificate=true
    username: app_user
    password: Password123!
    driver-class-name: com.microsoft.sqlserver.jdbc.SQLServerDriver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.SQLServerDialect
  data:
    redis:
      host: localhost
      port: 6379
      timeout: 60000
  cache:
    type: redis
    redis:
      time-to-live: 600000
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 5MB
  # Mail Configuration (using Gmail SMTP as example)
  mail:
    host: smtp.gmail.com
    port: 587
    username: ${MAIL_USERNAME:dimasamaulana30@gmail.com}
    password: ${MAIL_PASSWORD:tqvo jjjb qmgu yogg}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
